# Production: NODE_ENV=production
NODE_ENV=development
PORT=8787
# SQLite file path (node:sqlite, Node >= 22.5). Use a persistent volume in production.
DATABASE_URL=./data/exile.db
API_URL=http://localhost:8787
PUBLIC_SITE_URL=http://localhost:5173
ADMIN_SITE_URL=http://localhost:5174
# Comma-separated origins allowed by CORS (with credentials)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Long random string (>=32 chars). Used to salt IP hashes.
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string-32chars+
# Cookie SameSite: Lax if admin+API share a site, None (requires HTTPS) if cross-site
COOKIE_SAMESITE=Lax
SESSION_TTL_HOURS=12
# Optional download host allowlist (comma-separated, empty = any https host; own host always ok)
ALLOWED_DOWNLOAD_HOSTS=github.com,objects.githubusercontent.com
RATE_LIMIT_PER_MIN=120
LOGIN_RATE_LIMIT_PER_MIN=8
# First-run bootstrap: node src/server.mjs --create-admin
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Wasmer Edge ---
# node:sqlite does not exist there; use the WASM SQLite driver and a persistent volume:
#   DB_DRIVER=wasm
#   DATABASE_URL=/data/exile.db      (mount a volume at /data, see README)
DB_DRIVER=auto
